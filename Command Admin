-- === FONCTION DE RECHERCHE DYNAMIQUE ===
local function PerformSearch(query)
    if not query or query == "" then
        -- Afficher tout le contenu normal
        for _, child in ipairs(tabCmd:GetChildren()) do
            if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
                child.Visible = true
            end
        end
        return
    end
    
    local lowerQuery = query:lower()
    -- Masquer tous les éléments, puis afficher ceux qui correspondent
    for _, child in ipairs(tabCmd:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
            local text = child.Text or ""
            if text:lower():find(lowerQuery) then
                child.Visible = true
            else
                child.Visible = false
            end
        end
    end
end

searchBox.Changed:Connect(function(prop)
    if prop == "Text" then
        PerformSearch(searchBox.Text)
    end
end)

