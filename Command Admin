    local function PerformSearch(query)
        for _, child in ipairs(tabCmd:GetChildren()) do
            if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("TextBox") then
                if query and query ~= "" then
                    local text = child.Text or ""
                    child.Visible = text:lower():find(query:lower()) ~= nil
                else
                    child.Visible = true
                end
            end
        end
    end
    searchBox.Changed:Connect(function(prop)
        if prop == "Text" then PerformSearch(searchBox.Text) end
    end)
