local cmdBox = AddTextBox(tabCmd, "ex: kill Player", function(text)
    local parts = {}
    for word in text:gmatch("%S+") do
        table.insert(parts, word)
    end
    if #parts >= 1 then
        local cmd = parts[1]:lower()
        local args = {}
        for i = 2, #parts do table.insert(args, parts[i]) end
        local argStr = table.concat(args, " ")
        
        -- Ajouter à l'historique
        table.insert(AntonioHub.CommandHistory, 1, text)
        if #AntonioHub.CommandHistory > 50 then table.remove(AntonioHub.CommandHistory) end
        
        if Commands[cmd] and Commands[cmd].func then
            Commands[cmd].func(argStr)
        else
            Notify("AntonioHub", "Commande inconnue : " .. cmd, 2)
        end
    end
end, cmdY); cmdY = cmdY + 40

