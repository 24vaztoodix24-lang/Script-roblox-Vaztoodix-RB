    -- === GESTION DU DRAG (déplacement de la fenêtre) ===
    local function DragStart(input)
        local pos = input.Position
        local mainPos = main.Position
        AntonioHub.Dragging = true
        AntonioHub.DragStart = pos
        AntonioHub.StartPos = mainPos
    end
    
    local function DragUpdate(input)
        if AntonioHub.Dragging then
            local delta = input.Position - AntonioHub.DragStart
            main.Position = UDim2.new(
                AntonioHub.StartPos.X.Scale,
                AntonioHub.StartPos.X.Offset + delta.X,
                AntonioHub.StartPos.Y.Scale,
                AntonioHub.StartPos.Y.Offset + delta.Y
            )
        end
    end
    
    local function DragEnd()
        AntonioHub.Dragging = false
    end
    
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            DragStart(input)
        end
    end)
    
    titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            DragUpdate(input)
        end
    end)
    
    titleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            DragEnd()
        end
    end)
    
    -- === MINIMISER ===
    local minimized = false
    local originalSize = main.Size
    local originalPos = main.Position
    
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            main:TweenSize(UDim2.new(0, 220, 0, 35), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
            main:TweenPosition(UDim2.new(0.5, -110, 0.92, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
            contentContainer.Visible = false
            searchBar.Visible = false
            minBtn.Text = "+"
        else
            main:TweenSize(originalSize, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
            main:TweenPosition(originalPos, Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
            contentContainer.Visible = true
            searchBar.Visible = true
            minBtn.Text = "—"
        end
    end)
    
    -- === FERMER ===
    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)
    
    -- === RACCOURCI CLAVIER (F2 pour ouvrir/fermer) ===
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.F2 then
            if gui.Parent then
                gui.Enabled = not gui.Enabled
            end
        end
    end)
    
    -- === RACCOURCI POUR LA RECHERCHE (Ctrl+F) ===
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.F and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            searchBox:CaptureFocus()
        end
    end)
    
    -- === INITIALISATION DE L'HISTORIQUE ===
    UpdateHistory()
    
    Notify("AntonioHub", "Appuyez sur F2 pour ouvrir/fermer | Ctrl+F pour rechercher", 5)
end

