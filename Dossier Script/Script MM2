local function stroke(parent, color, radius, alpha)
    local s = new("Frame", {
        BackgroundColor3 = color,
        BackgroundTransparency = alpha or 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Position = UDim2.fromScale(0, 0),
