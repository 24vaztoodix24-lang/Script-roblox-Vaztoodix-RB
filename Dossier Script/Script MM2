-- Fonctions internes pour ajouter catégories, onglets, modules
function self:AddCategory(name)
    local btn = new("TextButton", {
        Size = UDim2.new(1, -12, 0, CAT_H),
        Position = UDim2.new(0, 6, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = T.sub,
        Font = FONT,
        TextSize = 14 * TEXT_SCALE,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 5,
        Parent = self.catList,
        AutoButtonColor = false,
    })
    local line = new("Frame", {
        Size = UDim2.new(0, 3, 0.6, 0),
        Position = UDim2.new(0, -6, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = T.star,
        BackgroundTransparency = 1,
        ZIndex = 6,
        Parent = btn,
    })
    btn.MouseEnter:Connect(function()
        tw(btn, FAST, { TextColor3 = T.text })
    end)
    btn.MouseLeave:Connect(function()
        if self.activeCategory ~= name then
            tw(btn, FAST, { TextColor3 = T.sub })
        end
    end)
    btn.MouseButton1Click:Connect(function()
        self:SetCategory(name)
    end)
    self.categories[name] = { button = btn, line = line, tabs = {} }
    if not self.activeCategory then
        self:SetCategory(name)
    end
    return self
end

function self:AddTab(category, tabName)
    local cat = self.categories[category]
    if not cat then return self end
    local tab = { name = tabName, modules = {} }
    table.insert(cat.tabs, tab)
    if not self.activeTab then
        self:SetTab(category, tabName)
    end
    -- Mettre à jour les onglets en haut
    self:RefreshTabs()
    return self
end

function self:RefreshTabs()
    for _, child in ipairs(self.tabHolder:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local cat = self.categories[self.activeCategory]
    if not cat then return end
    for _, tab in ipairs(cat.tabs) do
        local btn = new("TextButton", {
            Size = UDim2.fromOffset(0, TOPBAR_H - LOGO_ROW - 4),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text = tab.name,
            TextColor3 = (tab.name == self.activeTab) and T.text or T.dim,
            Font = FONT_BOLD,
            TextSize = 14 * TEXT_SCALE,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = 4,
            Parent = self.tabHolder,
            AutoButtonColor = false,
        })
        btn.MouseButton1Click:Connect(function()
            self:SetTab(self.activeCategory, tab.name)
        end)
    end
end

function self:SetCategory(name)
    self.activeCategory = name
    for cat, data in pairs(self.categories) do
        local col = (cat == name) and T.text or T.sub
        data.button.TextColor3 = col
        data.line.BackgroundTransparency = (cat == name) and 0 or 1
    end
    local cat = self.categories[name]
    if cat and #cat.tabs > 0 then
        self:SetTab(name, cat.tabs[1].name)
    else
        self.activeTab = nil
        self:RefreshTabs()
    end
end

function self:SetTab(category, tabName)
    self.activeTab = tabName
    self:RefreshTabs()
    self:RenderModules()
end 
    function self:RenderModules()
        for _, child in ipairs(self.moduleContainer:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end
        local cat = self.categories[self.activeCategory]
        if not cat then return end
        local tab = nil
        for _, t in ipairs(cat.tabs) do
            if t.name == self.activeTab then tab = t break end
        end
        if not tab then return end
        for _, mod in ipairs(tab.modules) do
            local frame = panel({
                Size = UDim2.new(1, -12, 0, ROW_H),
                Position = UDim2.new(0, 6, 0, 0),
                BackgroundColor3 = T.panel,
                ZIndex = 2,
                Parent = self.moduleContainer,
            }, 0)
            Instance.new("UICorner").CornerRadius = UDim.new(0, 6)
            local label = text({
                Text = mod.name,
                TextSize = 14,
                Font = FONT_BOLD,
                TextColor3 = T.text,
                Size = UDim2.new(0.6, -12, 1, 0),
                Position = UDim2.new(0, 12, 0, 0),
                ZIndex = 3,
                Parent = frame,
            })
            if mod.desc then
                local desc = text({
                    Text = mod.desc,
                    TextSize = 11,
                    Font = FONT_REG,
                    TextColor3 = T.descText,
                    Size = UDim2.new(0.6, -12, 0.5, 0),
                    Position = UDim2.new(0, 12, 0.6, 0),
                    ZIndex = 3,
                    Parent = frame,
                })
            end
            -- Bouton d'action (exemple)
            local action = new("TextButton", {
                Size = UDim2.fromOffset(80, 30),
                Position = UDim2.new(1, -96, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = T.stroke,
