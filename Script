    end
end

-- Miranda (script obfusqué, on l'exécute directement)
local mirandaExecuted=false
local function ExecMiranda()
    if mirandaExecuted then return end
    local ok,err=pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/chocolascript-glitch/MIRANDA-HUB-STEAL-AN-EGG/refs/heads/main/FREE-LEAKED"))()
    end)
    if ok then
        mirandaExecuted=true
        print("Miranda Hub chargé")
    else
        warn("Erreur Miranda : "..tostring(err))
    end
end

