    local mirInfo = Instance.new("TextLabel")
    mirInfo.Size = UDim2.new(1, 0, 0, 30)
    mirInfo.Position = UDim2.new(0, 0, 0, 120)
    mirInfo.BackgroundTransparency = 1
    mirInfo.Text = "Cliquez pour charger Miranda Hub"
    mirInfo.TextColor3 = Color3.new(0.6, 0.8, 1)
    mirInfo.TextSize = 14
    mirInfo.Font = Enum.Font.Gotham
    mirInfo.Parent = p4

    -- Raccourci T
    uis.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.T then
            Teleporter()
        end
        if not processed and input.KeyCode == Enum.KeyCode.Escape then
            sg:Destroy()
            GUI_ACTIVE = false
        end
    end)

    return sg
end

