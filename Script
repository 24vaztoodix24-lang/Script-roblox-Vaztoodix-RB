    mirBtn.Size = UDim2.new(0, 220, 0, 50)
    mirBtn.Position = UDim2.new(0.5, -110, 0, 50)
    mirBtn.BackgroundColor3 = Color3.new(0.7, 0.1, 0.1)
    mirBtn.Text = "Lancer Miranda Hub"
    mirBtn.TextColor3 = Color3.new(1, 1, 1)
    mirBtn.TextSize = 16
    mirBtn.Font = Enum.Font.GothamBold
    mirBtn.Parent = p4
