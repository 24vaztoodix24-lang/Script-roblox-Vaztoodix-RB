-- Script Roblox Vaztoodix - Interface refaite à zéro (sans bugs d'affichage)

local p = game:GetService("Players").LocalPlayer
local rs = game:GetService("RunService")
local uis = game:GetService("UserInputService")
local GUI_ACTIVE = true
local SWORDS_ACTIVE = true
local TELEPORT_ACTIVE = true
local swords = {}

-- [Conserver ici toutes les fonctions : ChangerNom, CreerArme, CreerArmeSpecial, 
-- CreerModeleArme, Teleporter, CreerSwords, scripts externes, etc.]

-- ===== NOUVELLE INTERFACE SIMPLIFIÉE (sans noms longs) =====
local function CreerInterface()
    -- Supprimer TOUTES les anciennes interfaces (même celles de Miranda/Chocola)
    for _, gui in pairs(p.PlayerGui:GetChildren()) do
        gui:Destroy()
    end

    local sg = Instance.new("ScreenGui")
    sg.Name = "VaztoodixHub"
    sg.ResetOnSpawn = false
    sg.Parent = p.PlayerGui

    -- Fond principal (plein écran)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BackgroundTransparency = 0.85
    bg.BorderSizePixel = 0
    bg.Parent = sg

    -- Fenêtre centrale
    local win = Instance.new("Frame")
    win.Size = UDim2.new(0, 500, 0, 420)
    win.Position = UDim2.new(0.5, -250, 0.5, -210)
    win.BackgroundColor3 = Color3.new(20, 20, 35)
    win.BackgroundTransparency = 0.1
    win.BorderSizePixel = 0
    win.Active = true
    win.Draggable = true
    win.Parent = sg

    -- Titre
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 45)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundColor3 = Color3.new(40, 40, 70)
    title.BackgroundTransparency = 0.2
    title.Text = "VAZTOODIX ™"
    title.TextColor3 = Color3.new(255, 255, 255)
    title.TextSize = 22
    title.Font = Enum.Font.GothamBold
    title.Parent = win

    -- Bouton fermer
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 30, 0, 30)
    close.Position = UDim2.new(0.93, 0, 0.02, 0)
    close.BackgroundColor3 = Color3.new(200, 40, 40)
    close.Text = "X"
    close.TextColor3 = Color3.new(255, 255, 255)
    close.TextSize = 16
    close.Font = Enum.Font.GothamBold
    close.Parent = win
    close.MouseButton1Click:Connect(function()
        sg:Destroy()
        GUI_ACTIVE = false
    end)

    -- ===== CONTENEUR DES ONGLETS =====
    local tabs = Instance.new("Frame")
    tabs.Size = UDim2.new(1, -20, 0, 35)
    tabs.Position = UDim2.new(0, 10, 0, 50)
    tabs.BackgroundTransparency = 1
    tabs.Parent = win

    -- Boutons d'onglets (4)
    local tabNames = {"Principale", "Crédits", "Chocola", "Miranda"}
    local tabBtns = {}
    local panels = {}

    for i, name in pairs(tabNames) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 110, 0, 30)
        btn.Position = UDim2.new(0, (i-1) * 115, 0, 0)
        btn.BackgroundColor3 = Color3.new(50, 50, 80)
        btn.Text = name
        btn.TextColor3 = Color3.new(255, 255, 255)
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.Parent = tabs
        tabBtns[i] = btn

        -- Panneau associé
        local panel = Instance.new("Frame")
        panel.Size = UDim2.new(1, -20, 1, -90)
        panel.Position = UDim2.new(0, 10, 0, 90)
        panel.BackgroundTransparency = 1
        panel.Visible = (i == 1)
        panel.Parent = win
        panels[i] = panel

        btn.MouseButton1Click:Connect(function()
            for j, p in pairs(panels) do
                p.Visible = (j == i)
            end
            for j, b in pairs(tabBtns) do
                b.BackgroundColor3 = (j == i) and Color3.new(80, 80, 140) or Color3.new(50, 50, 80)
            end
        end)
    end

    -- ===== PANEL 1 : PRINCIPALE =====
    local p1 = panels[1]

    -- Armes (3 boutons)
    local armes = {"zizi Tranchant", "Micha Minivichi", "istadyxx26 ★"}
    local yOff = 0.05
    for i, nom in pairs(armes) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 180, 0, 35)
        btn.Position = UDim2.new(i == 1 and 0.05 or 0.52, 0, yOff, 0)
        btn.BackgroundColor3 = (i == 3) and Color3.new(150, 50, 200) or Color3.new(60, 180, 60)
        btn.Text = nom .. " [ON]"
        btn.TextColor3 = Color3.new(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.Parent = p1
        local act = true
        btn.MouseButton1Click:Connect(function()
            act = not act
            btn.Text = nom .. (act and " [ON]" or " [OFF]")
            btn.BackgroundColor3 = act and (i == 3 and Color3.new(150, 50, 200) or Color3.new(60, 180, 60)) or Color3.new(180, 60, 60)
            local nomReel = string.gsub(nom, " ★", "")
            if act then
                if nomReel == "istadyxx26" then
                    CreerArmeSpecial()
                else
                    local couleur = (nomReel == "zizi Tranchant") and "Bright red" or "Bright blue"
                    local forme = (nomReel == "zizi Tranchant") and "spiral" or "double"
                    CreerArme(nomReel, (nomReel == "zizi Tranchant") and 500 or 600, couleur, forme)
                end
            else
                local t = p.Backpack:FindFirstChild(nomReel)
                if t then t:Destroy() end
                t = p.Character:FindFirstChild(nomReel)
                if t then t:Destroy() end
            end
        end)
        yOff = yOff + 0.2
    end

    -- Téléport
    local tele = Instance.new("TextButton")
    tele.Size = UDim2.new(0, 130, 0, 35)
    tele.Position = UDim2.new(0.05, 0, 0.6, 0)
    tele.BackgroundColor3 = Color3.new(40, 100, 200)
    tele.Text = "Téléport [ON]"
    tele.TextColor3 = Color3.new(255, 255, 255)
    tele.TextSize = 13
    tele.Font = Enum.Font.GothamBold
    tele.Parent = p1
    tele.MouseButton1Click:Connect(function()
        TELEPORT_ACTIVE = not TELEPORT_ACTIVE
        tele.Text = "Téléport " .. (TELEPORT_ACTIVE and "[ON]" or "[OFF]")
        tele.BackgroundColor3 = TELEPORT_ACTIVE and Color3.new(40, 100, 200) or Color3.new(100, 100, 100)
    end)

    -- Kill All
    local kill = Instance.new("TextButton")
    kill.Size = UDim2.new(0, 130, 0, 35)
    kill.Position = UDim2.new(0.52, 0, 0.6, 0)
    kill.BackgroundColor3 = Color3.new(180, 40, 40)
    kill.Text = "Tuer tous"
    kill.TextColor3 = Color3.new(255, 255, 255)
    kill.TextSize = 13
    kill.Font = Enum.Font.GothamBold
    kill.Parent = p1
    kill.MouseButton1Click:Connect(function()
        for _, v in pairs(game:GetService("Players"):GetPlayers()) do
            if v ~= p and v.Character then
                local h = v.Character:FindFirstChild("Humanoid")
                if h then
                    h.Health = 0
                    local e = Instance.new("Explosion")
                    e.Position = v.Character.HumanoidRootPart.Position
                    e.BlastRadius = 10
                    e.BlastPressure = 0
                    e.Parent = workspace
                end
            end
        end
        ChangerNom()
    end)

    -- Épées orbitales
    local sw = Instance.new("TextButton")
    sw.Size = UDim2.new(0, 160, 0, 35)
    sw.Position = UDim2.new(0.3, 0, 0.8, 0)
    sw.BackgroundColor3 = Color3.new(200, 150, 0)
    sw.Text = "Épées [ON]"
    sw.TextColor3 = Color3.new(255, 255, 255)
    sw.TextSize = 13
    sw.Font = Enum.Font.GothamBold
    sw.Parent = p1
    sw.MouseButton1Click:Connect(function()
        SWORDS_ACTIVE = not SWORDS_ACTIVE
        sw.Text = "Épées " .. (SWORDS_ACTIVE and "[ON]" or "[OFF]")
        sw.BackgroundColor3 = SWORDS_ACTIVE and Color3.new(200, 150, 0) or Color3.new(100, 100, 100)
        if SWORDS_ACTIVE then CreerSwords()
        else for _, s in pairs(swords) do s:Destroy() end swords = {} end
    end)

    -- ===== PANEL 2 : CRÉDITS =====
    local p2 = panels[2]
    local credits = Instance.new("TextLabel")
    credits.Size = UDim2.new(1, 0, 1, 0)
    credits.BackgroundTransparency = 1
    credits.Text = "Crédits :\nAntonio Vaztoodix\nMicha\nIsmaël Daniel\nDeepSeek"
    credits.TextColor3 = Color3.new(255, 255, 255)
    credits.TextSize = 20
    credits.Font = Enum.Font.GothamBold
    credits.TextScaled = true
    credits.Parent = p2

    -- ===== PANEL 3 : CHOCOLA =====
    local p3 = panels[3]
    local chocFns = {"m()", "Ma()", "Fa()", "K()"}
    for i, fn in pairs(chocFns) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 160, 0, 35)
        btn.Position = UDim2.new(0.1, 0, 0.05 + (i-1) * 0.2, 0)
        btn.BackgroundColor3 = Color3.new(60, 60, 120)
        btn.Text = "Lancer " .. fn
        btn.TextColor3 = Color3.new(255, 255, 255)
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.Parent = p3
        local funcName = string.sub(fn, 1, -3)
        btn.MouseButton1Click:Connect(function()
            if chocola[funcName] and type(chocola[funcName]) == "function" then
                pcall(chocola[funcName])
            end
        end)
    end

    -- ===== PANEL 4 : MIRANDA =====
    local p4 = panels[4]
    local mirBtn = Instance.new("TextButton")
    mirBtn.Size = UDim2.new(0, 200, 0, 45)
    mirBtn.Position = UDim2.new(0.3, 0, 0.3, 0)
    mirBtn.BackgroundColor3 = Color3.new(200, 50, 50)
    mirBtn.Text = "Lancer Miranda Hub"
    mirBtn.TextColor3 = Color3.new(255, 255, 255)
    mirBtn.TextSize = 16
    mirBtn.Font = Enum.Font.GothamBold
    mirBtn.Parent = p4
    mirBtn.MouseButton1Click:Connect(function()
        if not mirandaLoaded then
            pcall(function()
                loadstring(game:HttpGet("https://raw.githubusercontent.com/chocolascript-glitch/MIRANDA-HUB-STEAL-AN-EGG/refs/heads/main/FREE-LEAKED"))()
                mirandaLoaded = true
                mirBtn.Text = "✓ Miranda lancé"
                mirBtn.BackgroundColor3 = Color3.new(50, 200, 50)
            end)
        end
    end)

    local mirInfo = Instance.new("TextLabel")
    mirInfo.Size = UDim2.new(1, 0, 0, 30)
    mirInfo.Position = UDim2.new(0, 0, 0.6, 0)
    mirInfo.BackgroundTransparency = 1
    mirInfo.Text = "Cliquez pour charger Miranda Hub"
    mirInfo.TextColor3 = Color3.new(200, 200, 200)
    mirInfo.TextSize = 14
    mirInfo.Font = Enum.Font.Gotham
    mirInfo.Parent = p4

    -- Raccourci T pour téléport
    uis.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.T then
            Teleporter()
        end
    end)

    return sg
end

