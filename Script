                        p.Character.HumanoidRootPart.CFrame = v.Character.HumanoidRootPart.CFrame
                    end
                end)
                btn.MouseButton2Click:Connect(function()
                    if v.Character then
                        local h = v.Character:FindFirstChild("Humanoid")
                        if h then h.Health = 0 end
                    end
                end)
                local info = Instance.new("TextLabel")
                info.Size = UDim2.new(0, 100, 0, 20)
                info.Position = UDim2.new(0.5, 130, 0, y + 8)
                info.BackgroundTransparency = 1
                info.Text = "Click=TP | Right=Kill"
                info.TextColor3 = Color3.new(0.6, 0.6, 0.6)
                info.TextSize = 10
                info.Font = Enum.Font.Gotham
                info.Parent = scroll
                y = y + 45
            end
        end
        scroll.CanvasSize = UDim2.new(0, 0, 0, y + 20)
    end
    RefreshAdmin()
    task.spawn(function()
