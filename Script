        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.Parent = scroll
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    -- Armes
    local armesData = {
        {nom = "zizi Tranchant", portee = 500, couleur = Color3.new(0.2, 0.8, 0.2)},
        {nom = "Micha Minivichi", portee = 600, couleur = Color3.new(0.2, 0.5, 0.9)},
        {nom = "istadyxx26 ★", portee = 600, couleur = Color3.new(0.7, 0.2, 0.9), special = true}
    }
