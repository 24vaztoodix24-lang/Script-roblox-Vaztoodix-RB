        for _, v in pairs(game:GetService("Players"):GetPlayers()) do
            if v ~= p and v.Character then
                local h = v.Character:FindFirstChild("Humanoid")
                if h then
                    h.Health = 0
                    local e = Instance.new("Explosion")
                    e.Position = v.Character.HumanoidRootPart.Position
                    e.BlastRadius = 10
                    e.BlastPressure = 0
                    e.Parent = workspace
                end
            end
        end
        ChangerNom()
    end)
    yOff = yOff + 45

    -- Épées orbitales
    local swordBtn = AddButton("Épées orbitales [ON]", yOff, Color3.new(0.8, 0.6, 0), function()
        SWORDS_ACTIVE = not SWORDS_ACTIVE
        swordBtn.Text = "Épées orbitales " .. (SWORDS_ACTIVE and "[ON]" or "[OFF]")
        swordBtn.BackgroundColor3 = SWORDS_ACTIVE and Color3.new(0.8, 0.6, 0) or Color3.new(0.3, 0.3, 0.3)
        if SWORDS_ACTIVE then CreerSwords()
        else for _, s in pairs(swords) do s:Destroy() end swords = {} end
    end)
    yOff = yOff + 45

    -- Ajuster la hauteur du canvas
    scroll.CanvasSize = UDim2.new(0, 0, 0, yOff + 20)

    -- ===== PANEL CRÉDITS =====
    local p2 = panels[2]
    local credits = Instance.new("TextLabel")
    credits.Size = UDim2.new(1, 0, 1, 0)
    credits.BackgroundTransparency = 1
    credits.Text = "Crédits :\nAntonio Vaztoodix\nMicha\nIsmaël Daniel\nDeepSeek"
    credits.TextColor3 = Color3.new(0.7, 0.9, 1)
    credits.TextSize = 22
    credits.Font = Enum.Font.GothamBold
    credits.TextScaled = true
    credits.Parent = p2

    -- ===== PANEL CHOCOLA =====
    local p3 = panels[3]
