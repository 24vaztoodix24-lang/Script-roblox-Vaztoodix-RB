        panel.Size = UDim2.new(1, -20, 1, -100)
        panel.Position = UDim2.new(0, 10, 0, 100)
        panel.BackgroundTransparency = 1
        panel.Visible = (i == 1)
        panel.Parent = win
        panels[i] = panel

        btn.MouseButton1Click:Connect(function()
            for j, pnl in pairs(panels) do pnl.Visible = (j == i) end
            for j, b in pairs(tabBtns) do
                b.BackgroundColor3 = (j == i) and Color3.new(0.2, 0.4, 0.8) or Color3.new(0.15, 0.25, 0.5)
            end
        end)
    end

    -- ===== PANEL PRINCIPAL (avec ScrollingFrame) =====
    local p1 = panels[1]

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, 0)
