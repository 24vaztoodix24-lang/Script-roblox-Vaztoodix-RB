-- Changer nom
local function ChangerNom()
    local noms={"Alpha_99","Beta_X","Gamma_7","Delta_Zero","Echo_4"}
    p.DisplayName=noms[math.random(1,#noms)]..tostring(math.random(100,999))
end

-- Créer arme
local function CreerArme(nom,portee)
    local t=Instance.new("Tool")
    t.Name=nom
    t.RequiresHandle=false
    t.CanBeDropped=false
    t.Parent=p.Backpack
    t.Activated:Connect(function()
        local m=p:GetMouse()
        if not m then return end
        local pos=m.Hit.Position
        for _,v in pairs(game:GetService("Players"):GetPlayers())do
            if v~=p and v.Character then
                local h=v.Character:FindFirstChild("Humanoid")
                if h and v.Character:FindFirstChild("HumanoidRootPart")then
                    if (v.Character.HumanoidRootPart.Position-pos).Magnitude<=portee then
                        h.Health=0
                        local e=Instance.new("Explosion")
                        e.Position=v.Character.HumanoidRootPart.Position
                        e.BlastRadius=10
                        e.BlastPressure=0
                        e.Parent=workspace
                        ChangerNom()
                    end
                end
            end
        end
    end)
    return t
end
local function CreerToutesArmes()
    for _,a in pairs(ARMES)do
        if not p.Backpack:FindFirstChild(a.Nom)and not p.Character:FindFirstChild(a.Nom)then
            CreerArme(a.Nom,a.Portee)
        end
    end
end

-- Téléport
local function Teleporter()
    if not TELEPORT_ACTIVE then return end
    local m=p:GetMouse()
    if not m then return end
    local c=p.Character
    if c and c:FindFirstChild("HumanoidRootPart")then
        c:SetPrimaryPartCFrame(CFrame.new(m.Hit.Position))
    end
end

-- Épées orbitales
local function CreerSwords()
    if not SWORDS_ACTIVE then return end
    for _,s in pairs(swords)do s:Destroy()end
    swords={}
    local c=p.Character
    if not c then return end
    local r=c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    for i=1,6 do
        local s=Instance.new("Part")
        s.Size=Vector3.new(0.2,1,0.2)
        s.BrickColor=BrickColor.new("Bright red")
        s.Material=Enum.Material.Neon
        s.Anchored=false
        s.CanCollide=false
        s.Parent=workspace
        local w=Instance.new("Weld")
        w.Part0=r
        w.Part1=s
        w.C0=CFrame.new(0,0,0)*CFrame.Angles(0,math.rad(i*60),0)*CFrame.new(3,0,0)
        w.Parent=s
        local tr=Instance.new("Trail")
        tr.Parent=s
        tr.Lifetime=0.5
        tr.MinLength=1
        tr.MaxLength=5
        tr.Color=Color3.new(1,0,0)
        tr.Transparency=NumberSequence.new(0,1)
        table.insert(swords,s)
    end
end

rs.Heartbeat:Connect(function()
    if SWORDS_ACTIVE and p.Character then
        local r=p.Character:FindFirstChild("HumanoidRootPart")
        if r then
            local a=0
            for _,s in pairs(swords)do
                if s and s.Parent then
                    local w=s:FindFirstChild("Weld")
                    if w then
                        a=a+0.02
                        w.C0=CFrame.new(0,0,0)*CFrame.Angles(0,a,0)*CFrame.new(3,0,0)
                    end
                end
            end
        end
    end
end)

-- Charger script Chocola (fonctions externes)
local chocola={}
local ok,res=pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/chocolascript-glitch/Chocola-Pet-Spawner-steal-an-egg/refs/heads/main/script.lua"))()
end)
if ok and type(res)=="table" then chocola=res end
local function ExecChoc(nom,...)
    if chocola[nom] and type(chocola[nom])=="function" then
        pcall(chocola[nom],...)
    end
end

