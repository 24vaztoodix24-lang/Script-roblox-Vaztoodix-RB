-- Script Roblox pour Delta Executor / Solara v3
-- Spawn d'arme 1-hit avec changement de nom dynamique

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

-- Configuration
local ARME_NOM = "Railgun"
local PORTEE = 500

-- Fonction de changement de nom (corrigée)
local function ChangerNom()
    local noms = {"Alpha_99", "Beta_X", "Gamma_7", "Delta_Zero", "Echo_4"}
    local nouveauNom = noms[math.random(1, #noms)] .. tostring(math.random(100, 999))
    LocalPlayer.DisplayName = nouveauNom
end

-- Création de l'arme
local function CreerArme()
    local tool = Instance.new("Tool")
    tool.Name = ARME_NOM
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Parent = LocalPlayer.Backpack

    tool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if not mouse then return end
        local targetPos = mouse.Hit.Position
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and char:FindFirstChild("HumanoidRootPart") then
                    local distance = (char.HumanoidRootPart.Position - targetPos).Magnitude
                    if distance <= PORTEE then
                        humanoid.Health = 0
                        ChangerNom()
                    end
                end
            end
        end
    end)
    return tool
end

-- Boucle de ré-spawn
RunService.Heartbeat:Connect(function()
    if not LocalPlayer.Backpack:FindFirstChild(Zizi_Tranchant) and not LocalPlayer.Character:FindFirstChild(ARME_NOM) then
        CreerArme()
    end
end)

-- Changement de nom périodique
task.spawn(function()
    while task.wait(30) do
        ChangerNom()
    end
end)

-- Premier spawn
CreerArme()
print("Script chargé - Arme " .. Zizi_Tranchant .. " prête")
