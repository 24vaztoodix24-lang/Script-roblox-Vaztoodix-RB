-- Modèles 3D pour armes (inchangé)
local function CreerModeleArme(couleur, forme)
    local model = Instance.new("Model")
    local handle = Instance.new("Part")
    handle.Size = Vector3.new(1, 0.2, 2)
    handle.BrickColor = BrickColor.new(couleur or "Bright red")
    handle.Material = Enum.Material.Neon
    handle.Anchored = false
    handle.CanCollide = false
    handle.Parent = model
    local light = Instance.new("PointLight")
    light.Parent = handle
    light.Range = 8
    light.Brightness = 3
    light.Color = handle.BrickColor.Color
    if forme == "spiral" then
        for i = 1, 3 do
            local ring = Instance.new("Part")
            ring.Size = Vector3.new(0.8 + i * 0.1, 0.05, 0.8 + i * 0.1)
            ring.Shape = Enum.PartType.Cylinder
            ring.BrickColor = BrickColor.new(couleur or "Bright red")
            ring.Material = Enum.Material.Neon
            ring.Anchored = false
            ring.CanCollide = false
            ring.Parent = model
            local w = Instance.new("Weld")
            w.Part0 = handle
            w.Part1 = ring
            w.C0 = CFrame.new(0, i * 0.3 - 0.3, 0) * CFrame.Angles(0, math.rad(i * 30), math.rad(i * 15))
            w.Parent = ring
        end
    elseif forme == "double" then
        for _, off in pairs({{-0.5, 0, 0}, {0.5, 0, 0}}) do
            local blade = Instance.new("Part")
            blade.Size = Vector3.new(0.1, 1.5, 0.1)
            blade.BrickColor = BrickColor.new("Bright blue")
            blade.Material = Enum.Material.Neon
            blade.Anchored = false
            blade.CanCollide = false
            blade.Parent = model
            local w = Instance.new("Weld")
            w.Part0 = handle
            w.Part1 = blade
            w.C0 = CFrame.new(off[1], off[2] + 0.5, off[3]) * CFrame.Angles(0, 0, math.rad(15))
            w.Parent = blade
        end
    end
    return model
end

-- Arme spéciale (istadyxx26)
local function CreerArmeSpecial()
    local t = Instance.new("Tool")
    t.Name = "istadyxx26"
    t.RequiresHandle = false
    t.CanBeDropped = false
    t.Parent = p.Backpack
    local model = CreerModeleArme("Bright violet", "double")
    local handle = model:FindFirstChildOfClass("Part")
    if handle then
        handle.Parent = t
        t.Handle = handle
        t.RequiresHandle = true
    end
    rs.RenderStepped:Connect(function()
        if t.Parent == p.Backpack or t.Parent == p.Character then
            local h = t:FindFirstChild("Handle")
            if h then h.CFrame = h.CFrame * CFrame.Angles(0, 0.01, 0.01) end
        end
    end)
    t.Activated:Connect(function()
        local m = p:GetMouse()
        if not m then return end
        local pos = m.Hit.Position
        for _, v in pairs(game:GetService("Players"):GetPlayers()) do
            if v ~= p and v.Character then
                local h = v.Character:FindFirstChild("Humanoid")
                if h and v.Character:FindFirstChild("HumanoidRootPart") then
                    if (v.Character.HumanoidRootPart.Position - pos).Magnitude <= 600 then
                        h.Health = 0
                        local hrp = v.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            for i = 1, 8 do
                                local e = Instance.new("Explosion")
                                e.Position = hrp.Position + Vector3.new(math.random(-6,6), math.random(-2,4), math.random(-6,6))
                                e.BlastRadius = 6
                                e.BlastPressure = 0
                                e.ExplosionType = Enum.ExplosionType.NoCraters
                                e.Parent = workspace
                            end
                            for i = 1, 15 do
                                local part = Instance.new("Part")
                                part.Size = Vector3.new(0.4, 0.4, 0.4)
                                part.BrickColor = BrickColor.random()
                                part.Material = Enum.Material.Neon
                                part.Anchored = true
                                part.CanCollide = false
                                part.Position = hrp.Position + Vector3.new(math.random(-4,4), math.random(0,4), math.random(-4,4))
                                part.Parent = workspace
                                game:GetService("Debris"):AddItem(part, 1.5)
                            end
                            pcall(function()
                                local cam = workspace.CurrentCamera
                                local orig = cam.CFrame
                                for i = 1, 8 do
                                    cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(math.random(-3,3)), math.rad(math.random(-3,3)), 0)
                                    task.wait(0.015)
                                end
                                cam.CFrame = orig
                            end)
                        end
                        ChangerNom()
                    end
                end
            end
        end
    end)
    return t
end

-- Arme normale (avec modèle 3D)
local function CreerArme(nom, portee, couleur, forme)
    local t = Instance.new("Tool")
    t.Name = nom
    t.RequiresHandle = false
    t.CanBeDropped = false
    t.Parent = p.Backpack
    local model = CreerModeleArme(couleur or "Bright red", forme or "spiral")
    local handle = model:FindFirstChildOfClass("Part")
    if handle then
        handle.Parent = t
        t.Handle = handle
        t.RequiresHandle = true
    end
    rs.RenderStepped:Connect(function()
        if t.Parent == p.Backpack or t.Parent == p.Character then
            local h = t:FindFirstChild("Handle")
            if h then h.CFrame = h.CFrame * CFrame.Angles(0, 0.01, 0) end
        end
    end)
    t.Activated:Connect(function()
        local m = p:GetMouse()
        if not m then return end
        local pos = m.Hit.Position
        for _, v in pairs(game:GetService("Players"):GetPlayers()) do
            if v ~= p and v.Character then
                local h = v.Character:FindFirstChild("Humanoid")
                if h and v.Character:FindFirstChild("HumanoidRootPart") then
                    if (v.Character.HumanoidRootPart.Position - pos).Magnitude <= portee then
                        h.Health = 0
                        ChangerNom()
                    end
                end
            end
        end
    end)
    return t
end

local function CreerToutesArmes()
    local list = {
        {Nom = "zizi Tranchant", Portee = 500, Couleur = "Bright red", Forme = "spiral"},
        {Nom = "Micha Minivichi", Portee = 600, Couleur = "Bright blue", Forme = "double"},
        {Nom = "istadyxx26", Portee = 600, Special = true}
    }
    for _, a in pairs(list) do
        if not p.Backpack:FindFirstChild(a.Nom) and not p.Character:FindFirstChild(a.Nom) then
            if a.Special then CreerArmeSpecial() else CreerArme(a.Nom, a.Portee, a.Couleur, a.Forme) end
        end
    end
end

-- Téléport
local function Teleporter()
    if not TELEPORT_ACTIVE then return end
    local m = p:GetMouse()
    if not m then return end
    local c = p.Character
    if c and c:FindFirstChild("HumanoidRootPart") then
        c:SetPrimaryPartCFrame(CFrame.new(m.Hit.Position))
    end
end

-- Épées orbitales
local function CreerSwords()
    if not SWORDS_ACTIVE then return end
    for _, s in pairs(swords) do s:Destroy() end
    swords = {}
    local c = p.Character
    if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    for i = 1, 6 do
        local s = Instance.new("Part")
        s.Size = Vector3.new(0.2, 1, 0.2)
        s.BrickColor = BrickColor.new("Bright red")
        s.Material = Enum.Material.Neon
        s.Anchored = false
        s.CanCollide = false
        s.Parent = workspace
        local w = Instance.new("Weld")
        w.Part0 = r
        w.Part1 = s
        w.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(i * 60), 0) * CFrame.new(3, 0, 0)
        w.Parent = s
        local tr = Instance.new("Trail")
        tr.Parent = s
        tr.Lifetime = 0.5
        tr.MinLength = 1
        tr.MaxLength = 5
        tr.Color = Color3.new(1, 0, 0)
        tr.Transparency = NumberSequence.new(0, 1)
        table.insert(swords, s)
    end
end

rs.Heartbeat:Connect(function()
    if SWORDS_ACTIVE and p.Character then
        local r = p.Character:FindFirstChild("HumanoidRootPart")
        if r then
            local ang = 0
            for _, s in pairs(swords) do
                local w = s:FindFirstChild("Weld")
                if w then
                    ang = ang + 0.02
                    w.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, ang, 0) * CFrame.new(3, 0, 0)
                end
            end
        end
    end
end)

