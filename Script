-- Script Roblox pour Delta Executor / Solara v3
-- Spawn de 2 armes 1-hit + téléportation + effets visuels (épées orbitales)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- Configuration
local ARMES = {
    {Nom = "zizi Tranchant", Portee = 500},
    {Nom = "Micha Minivichi", Portee = 600}
}
local GUI_ACTIVE = true
local TELEPORT_ACTIVE = true
local SWORDS_ACTIVE = true
local swords = {} -- pour stocker les épées

-- Fonction de changement de nom
local function ChangerNom()
    local noms = {"Alpha_99", "Beta_X", "Gamma_7", "Delta_Zero", "Echo_4"}
    local nouveauNom = noms[math.random(1, #noms)] .. tostring(math.random(100, 999))
    LocalPlayer.DisplayName = nouveauNom
end

-- Création d'une arme
local function CreerArme(nomArme, portee)
    local tool = Instance.new("Tool")
    tool.Name = nomArme
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Parent = LocalPlayer.Backpack

    tool.Activated:Connect(function()
        local mouse = LocalPlayer:GetMouse()
        if not mouse then return end
        local targetPos = mouse.Hit.Position
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and char:FindFirstChild("HumanoidRootPart") then
                    local distance = (char.HumanoidRootPart.Position - targetPos).Magnitude
                    if distance <= portee then
                        humanoid.Health = 0
                        -- Effet d'explosion sur le joueur tué
                        local explosion = Instance.new("Explosion")
                        explosion.Position = char.HumanoidRootPart.Position
                        explosion.BlastRadius = 10
                        explosion.BlastPressure = 0
                        explosion.Parent = workspace
                        ChangerNom()
                    end
                end
            end
        end
    end)
    return tool
end

-- Création des 2 armes
local function CreerToutesArmes()
    for _, arme in pairs(ARMES) do
        if not LocalPlayer.Backpack:FindFirstChild(arme.Nom) and not LocalPlayer.Character:FindFirstChild(arme.Nom) then
            CreerArme(arme.Nom, arme.Portee)
        end
    end
end

-- Téléportation vers la souris
local function Teleporter()
    if not TELEPORT_ACTIVE then return end
    local mouse = LocalPlayer:GetMouse()
    if not mouse then return end
    local targetPos = mouse.Hit.Position
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char:SetPrimaryPartCFrame(CFrame.new(targetPos))
    end
end

-- Création des épées orbitales
local function CreerSwords()
    if not SWORDS_ACTIVE then return end
    -- Supprimer les anciennes
    for _, sword in pairs(swords) do
        sword:Destroy()
    end
    swords = {}

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for i = 1, 6 do
        local sword = Instance.new("Part")
        sword.Size = Vector3.new(0.2, 1, 0.2)
        sword.BrickColor = BrickColor.new("Bright red")
        sword.Material = Enum.Material.Neon
        sword.Anchored = false
        sword.CanCollide = false
        sword.Parent = workspace

        -- Attacher au personnage avec un Weld
        local weld = Instance.new("Weld")
        weld.Part0 = root
        weld.Part1 = sword
        weld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(i * 60), 0) * CFrame.new(3, 0, 0)
        weld.Parent = sword

        -- Ajouter un effet de trail
        local trail = Instance.new("Trail")
        trail.Parent = sword
        trail.Lifetime = 0.5
        trail.MinLength = 1
        trail.MaxLength = 5
        trail.Color = Color3.new(1, 0, 0)
        trail.Transparency = NumberSequence.new(0, 1)

        table.insert(swords, sword)
    end
end

-- Mise à jour de la rotation des épées (effet orbital)
RunService.Heartbeat:Connect(function()
    if SWORDS_ACTIVE and LocalPlayer.Character then
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local angle = 0
            for _, sword in pairs(swords) do
                if sword and sword.Parent then
                    local weld = sword:FindFirstChild("Weld")
                    if weld then
                        angle = angle + 0.02
                        weld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(3, 0, 0)
                    end
                end
            end
        end
    end
end)

-- Interface graphique améliorée
local function CreerInterface()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "VaztoodixGUI"
    screenGui.Parent = LocalPlayer.PlayerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 400, 0, 350)
    frame.Position = UDim2.new(0.5, -200, 0.5, -175)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screenGui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    title.BackgroundTransparency = 0.3
    title.Text = "Vaztoodix ™ - Hack Ultimate"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 18
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    -- Boutons pour chaque arme
    local yOffset = 0.35
    for i, arme in pairs(ARMES) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 140, 0, 35)
        btn.Position = UDim2.new(i == 1 and 0.08 or 0.52, 0, yOffset, 0)
        btn.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
        btn.Text = arme.Nom .. " [ON]"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.Parent = frame

        local active = true
        btn.MouseButton1Click:Connect(function()
            active = not active
            btn.Text = arme.Nom .. (active and " [ON]" or " [OFF]")
            btn.BackgroundColor3 = active and Color3.fromRGB(60, 180, 60) or Color3.fromRGB(180, 60, 60)
            if active then
                CreerArme(arme.Nom, arme.Portee)
            else
                local tool = LocalPlayer.Backpack:FindFirstChild(arme.Nom)
                if tool then tool:Destroy() end
                tool = LocalPlayer.Character:FindFirstChild(arme.Nom)
                if tool then tool:Destroy() end
            end
        end)
        yOffset = yOffset + 0.22
    end

    -- Bouton Téléportation
    local teleBtn = Instance.new("TextButton")
    teleBtn.Size = UDim2.new(0, 120, 0, 35)
    teleBtn.Position = UDim2.new(0.08, 0, 0.78, 0)
    teleBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 200)
    teleBtn.Text = "TELÉPORT [ON]"
    teleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    teleBtn.TextSize = 14
    teleBtn.Font = Enum.Font.GothamBold
    teleBtn.Parent = frame
    teleBtn.MouseButton1Click:Connect(function()
        TELEPORT_ACTIVE = not TELEPORT_ACTIVE
        teleBtn.Text = "TÉLÉPORT " .. (TELEPORT_ACTIVE and "[ON]" or "[OFF]")
        teleBtn.BackgroundColor3 = TELEPORT_ACTIVE and Color3.fromRGB(40, 100, 200) or Color3.fromRGB(100, 100, 100)
    end)

    -- Bouton Kill All
    local killBtn = Instance.new("TextButton")
    killBtn.Size = UDim2.new(0, 120, 0, 35)
    killBtn.Position = UDim2.new(0.52, 0, 0.78, 0)
    killBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    killBtn.Text = "TUER TOUS"
    killBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    killBtn.TextSize = 14
    killBtn.Font = Enum.Font.GothamBold
    killBtn.Parent = frame
    killBtn.MouseButton1Click:Connect(function()
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid.Health = 0
                    local explosion = Instance.new("Explosion")
                    explosion.Position = player.Character.HumanoidRootPart.Position
                    explosion.BlastRadius = 10
                    explosion.BlastPressure = 0
                    explosion.Parent = workspace
                end
            end
        end
        ChangerNom()
    end)

    -- Bouton Épées orbitales
    local swordBtn = Instance.new("TextButton")
    swordBtn.Size = UDim2.new(0, 140, 0, 35)
    swordBtn.Position = UDim2.new(0.33, 0, 0.9, 0)
    swordBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    swordBtn.Text = "ÉPÉES [ON]"
    swordBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    swordBtn.TextSize = 14
    swordBtn.Font = Enum.Font.GothamBold
    swordBtn.Parent = frame
    swordBtn.MouseButton1Click:Connect(function()
        SWORDS_ACTIVE = not SWORDS_ACTIVE
        swordBtn.Text = "ÉPÉES " .. (SWORDS_ACTIVE and "[ON]" or "[OFF]")
        swordBtn.BackgroundColor3 = SWORDS_ACTIVE and Color3.fromRGB(200, 150, 0) or Color3.fromRGB(100, 100, 100)
        if SWORDS_ACTIVE then
            CreerSwords()
        else
            for _, sword in pairs(swords) do
                sword:Destroy()
            end
            swords = {}
        end
    end)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(0.9, 0, 0.05, 0)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.TextSize = 14
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.Parent = frame
    closeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
        GUI_ACTIVE = false
    end)

    -- Raccourci clavier : T pour téléporter, E pour épées ?
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            screenGui:Destroy()
            GUI_ACTIVE = false
        elseif input.KeyCode == Enum.KeyCode.T then
            Teleporter()
        end
    end)

    return screenGui
end

-- Boucle de ré-spawn pour les 2 armes
RunService.Heartbeat:Connect(function()
    if GUI_ACTIVE then
        for _, arme in pairs(ARMES) do
            if not LocalPlayer.Backpack:FindFirstChild(arme.Nom) and not LocalPlayer.Character:FindFirstChild(arme.Nom) then
                CreerArme(arme.Nom, arme.Portee)
            end
        end
    end
    -- Mise à jour des épées si actives
    if SWORDS_ACTIVE and #swords == 0 and LocalPlayer.Character then
        CreerSwords()
    end
end)

-- Changement de nom périodique
task.spawn(function()
    while task.wait(30) do
        if GUI_ACTIVE then
            ChangerNom()
        end
    end
end)

-- Initialisation
CreerToutesArmes()
CreerInterface()
CreerSwords()
print("Script charge - 2 armes, teleport, epées orbitales | GUI active")
print("Touche T pour te téléporter à la souris")
